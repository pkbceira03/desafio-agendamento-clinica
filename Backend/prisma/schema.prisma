generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Appointment {
  id        String   @id @default(uuid())
  name      String
  phone     String
  date      DateTime @db.Date
  time      String
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([date, time])
  @@map("appointments")
}